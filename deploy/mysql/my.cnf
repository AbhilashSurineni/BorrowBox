# MySQL 8 settings for BorrowBox on Render (private service).
[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
# Lets Flyway create the loans overlap triggers as the non-SUPER app user (docs/DB_NOTES.md).
log_bin_trust_function_creators = 1
# Render disks contain a lost+found directory, so MySQL keeps its data in a sub-directory.
datadir = /var/lib/mysql/data
# Fits a small instance (512 MB - 1 GB RAM).
innodb_buffer_pool_size = 128M
performance_schema = OFF
max_connections = 50
