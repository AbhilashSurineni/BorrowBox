# Base URL of the BorrowBox API (Spring Boot). The refresh token is an httpOnly cookie, so the
# API must allow this app's origin (APP_URL / CORS_ORIGIN) with credentials.
VITE_API_URL=http://localhost:8080/api/v1
# Campus email domain(s) checked client-side at registration (the API enforces ALLOWED_EMAIL_DOMAIN).
VITE_ALLOWED_EMAIL_DOMAIN=campus.edu
