# Spring Boot reads these from the environment (export them, or use docker-compose / your IDE run config).
SPRING_PROFILES_ACTIVE=dev            # dev | test | prod
PORT=8080

DB_URL=jdbc:mysql://localhost:3306/borrowbox?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USER=borrowbox
DB_PASSWORD=borrowbox

# Required in prod (dev has defaults). Any length >= 16; keys are derived with SHA-256.
JWT_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SAMESITE=Lax                   # Lax | Strict | None (None forces Secure)
COOKIE_SECURE=false                   # always true in the prod profile

APP_URL=http://localhost:5173          # frontend origin: CORS + links in emails
API_PUBLIC_URL=http://localhost:8080   # used for uploaded image URLs
ALLOWED_EMAIL_DOMAIN=campus.edu        # comma-separated campus domains
APP_TIMEZONE=UTC                       # campus timezone for "today" and the cron schedules

# Mail: MAIL_MODE=log prints emails to the console (dev default); smtp uses the settings below.
MAIL_MODE=log
MAIL_FROM="BorrowBox <no-reply@campus.edu>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Storage: local (served from /uploads). cloudinary and s3 are stubs for now.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CRON_ENABLED=true
RATE_LIMIT_ENABLED=true

# Admin account seeded at startup (idempotent). Demo data is seeded in the dev profile only.
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=Admin12345

# Tests: Testcontainers starts MySQL automatically; set these to use an existing database instead (CI).
# TEST_DB_URL=jdbc:mysql://localhost:3306/borrowbox_test
# TEST_DB_USER=borrowbox
# TEST_DB_PASSWORD=borrowbox
